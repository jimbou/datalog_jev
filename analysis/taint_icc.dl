// GENERATED by analysis/make_taint_icc.py from taint.dl; do not edit
// Whole-app, context-insensitive taint analysis with priced library holes.
// Every method shipped in the APK is treated as reachable (Android entry points are implicit);
// only calls whose declared type ships in the APK dispatch into app code (framework callbacks
// are a separate, unmodeled hole). Library-flow atoms of framework methods are candidate
// facts; taint is propagated with all candidates on (T*), then restricted to nodes that can
// still reach a sink (B*). Only that relevant subgraph is output, for min-cut in Python.

.type Var = symbol

.decl Alloc(v:Var, h:symbol, t:symbol)
.decl Move(to:Var, from:Var)
.decl Load(to:Var, b:Var, f:symbol)
.decl Store(b:Var, f:symbol, from:Var)
.decl SLoad(to:Var, f:symbol)
.decl SStore(f:symbol, from:Var)
.decl Call(site:symbol, m:symbol, kind:symbol, cls:symbol, sub:symbol, base:symbol, ret:symbol)
.decl Arg(site:symbol, i:number, a:symbol)
.decl FormalParam(m:symbol, i:number, v:Var)
.decl ThisVar(m:symbol, v:Var)
.decl RetVar(m:symbol, v:Var)
.decl MethodDecl(cls:symbol, sub:symbol, sig:symbol, st:symbol, conc:symbol)
.decl Super(c:symbol, s:symbol)
.decl Class(c:symbol, kind:symbol)
.input Alloc, Move, Load, Store, SLoad, SStore, Call, Arg, FormalParam, ThisVar, RetVar, MethodDecl, Super, Class

// Prepared by Python: hole atoms (endpoints in {argN,this,ret}), source/sink methods,
// and library return types that carry no heap object (strings, boxed values, primitives).
.decl HoleAtom(cls:symbol, sub:symbol, k:number, src:symbol, tgt:symbol)
.decl SourceMethod(cls:symbol, sub:symbol)
.decl SinkMethod(cls:symbol, sub:symbol)
.decl ValueSub(sub:symbol)
.input HoleAtom, SourceMethod, SinkMethod, ValueSub

// Types: local variable types (Soot), framework supertypes (android.jar), library return types.
.decl VarType(v:Var, t:symbol)
.decl FwSuper(c:symbol, s:symbol)
.decl SubRet(sub:symbol, t:symbol)
.input VarType, FwSuper, SubRet

// ---- call graph (CHA restricted to types shipped in the APK) ----
.decl Declares(c:symbol, sub:symbol, m:symbol)
Declares(c, sub, m) :- MethodDecl(c, sub, m, _, "concrete").
.decl DeclaresAny(c:symbol, sub:symbol)
DeclaresAny(c, sub) :- MethodDecl(c, sub, _, _, _).
.decl Resolve(c:symbol, sub:symbol, m:symbol)
Resolve(c, sub, m) :- Declares(c, sub, m).
Resolve(c, sub, m) :- Class(c, _), Super(c, s), Resolve(s, sub, m), !DeclaresAny(c, sub).
.decl SubType(d:symbol, c:symbol)
SubType(c, c) :- Class(c, _).
SubType(d, c) :- Super(d, s), SubType(s, c).
.decl Target(site:symbol, m:symbol)
Target(site, m) :- Call(site, _, kind, c, sub, _, _), (kind = "static" ; kind = "special"), Resolve(c, sub, m).
Target(site, m) :- Call(site, _, "virtual", c, sub, _, _), Class(c, _), SubType(d, c), Class(d, "class"), Resolve(d, sub, m).
.decl HasTarget(site:symbol)
HasTarget(site) :- Target(site, _).
.decl LibCall(site:symbol, c:symbol, sub:symbol, base:symbol, ret:symbol)
LibCall(site, c, sub, b, r) :- Call(site, _, kind, c, sub, b, r), kind != "dynamic", !HasTarget(site).

// ---- type hierarchy over APK classes and the framework ----
.decl SubT(d:symbol, c:symbol)
SubT(c, c) :- Class(c, _).
SubT(c, c) :- FwSuper(c, _).
SubT(c, s) :- FwSuper(c, s).
SubT(d, c) :- Super(d, s), SubT(s, c).
.decl Known(t:symbol)
Known(t) :- SubT(t, _).
.decl HasVarType(v:Var)
HasVarType(v) :- VarType(v, _).
// variables whose type cannot filter anything: Object, arrays, types outside the hierarchy
.decl Loose(vt:symbol)
Loose(vt) :- VarType(_, vt), (vt = "java.lang.Object" ; !Known(vt)).

// ---- points-to (Andersen, type-filtered) ----
.decl Assign(to:Var, from:Var)
Assign(to, from) :- Move(to, from).
Assign(f, a) :- Target(site, m), Arg(site, i, a), FormalParam(m, i, f).
Assign(t, b) :- Target(site, m), Call(site, _, _, _, _, b, _), b != "-", ThisVar(m, t).
Assign(r, rv) :- Target(site, m), Call(site, _, _, _, _, _, r), r != "-", RetVar(m, rv).
.decl HeapType(h:symbol, t:symbol)
HeapType(h, t) :- Alloc(_, h, t), t != "java.lang.String".
HeapType(cat("lib:", site), t) :- LibCall(site, _, sub, _, r), r != "-", !ValueSub(sub), SubRet(sub, t).
.decl UnknownHeap(h:symbol)
UnknownHeap(h) :- HeapType(h, t), !Known(t).
// Admit(v, h): object h may be held by variable v under the declared type of v
.decl Pts(v:Var, h:symbol)
Pts(v, h) :- Alloc(v, h, t), t != "java.lang.String".
Pts(r, cat("lib:", site)) :- LibCall(site, _, sub, _, r), r != "-", !ValueSub(sub).
Pts(to, h) :- Assign(to, from), Pts(from, h), VarType(to, vt), HeapType(h, t), (SubT(t, vt) ; Loose(vt) ; UnknownHeap(h)).
Pts(to, h) :- Assign(to, from), Pts(from, h), !HasVarType(to).
.decl HPts(h:symbol, f:symbol, h2:symbol)
HPts(h, f, h2) :- Store(b, f, from), Pts(b, h), Pts(from, h2).
HPts("static", f, h2) :- SStore(f, from), Pts(from, h2).
Pts(to, h2) :- Load(to, b, f), Pts(b, h), HPts(h, f, h2), VarType(to, vt), HeapType(h2, t), (SubT(t, vt) ; Loose(vt) ; UnknownHeap(h2)).
Pts(to, h2) :- SLoad(to, f), HPts("static", f, h2), VarType(to, vt), HeapType(h2, t), (SubT(t, vt) ; Loose(vt) ; UnknownHeap(h2)).
Pts(to, h2) :- Load(to, b, f), Pts(b, h), HPts(h, f, h2), !HasVarType(to).
Pts(to, h2) :- SLoad(to, f), HPts("static", f, h2), !HasVarType(to).

// ---- candidate hole atoms at library call sites ----
.decl End(site:symbol, e:symbol, v:Var)
End(site, cat("arg", to_string(i)), a) :- LibCall(site, _, _, _, _), Arg(site, i, a), !match("str:.*", a), !match("cls:.*", a), a != "-".
End(site, "this", b) :- LibCall(site, _, _, b, _), b != "-".
End(site, "ret", r) :- LibCall(site, _, _, _, r), r != "-".
.decl CandSrc(site:symbol, k:number, v:Var)
CandSrc(site, k, sv) :- LibCall(site, c, sub, _, _), HoleAtom(c, sub, k, s, t), End(site, s, sv), End(site, t, _).
.decl CandTgtV(site:symbol, k:number, v:Var)
CandTgtV(site, k, tv) :- CandSrc(site, k, _), LibCall(site, c, sub, _, _), HoleAtom(c, sub, k, _, t), End(site, t, tv).
.decl CandTgtH(site:symbol, k:number, h:symbol)
CandTgtH(site, k, h) :- CandTgtV(site, k, tv), LibCall(site, c, sub, _, _), HoleAtom(c, sub, k, _, t), t != "ret", Pts(tv, h).

// ---- forward taint with every candidate on ----
.decl TV(v:Var)
.decl TH(h:symbol)
.decl TF(h:symbol, f:symbol)
.decl TS(f:symbol)
.decl TM(site:symbol, k:number)
TV(r) :- LibCall(_, c, sub, _, r), SourceMethod(c, sub), r != "-".
TH(h) :- LibCall(_, c, sub, _, r), SourceMethod(c, sub), r != "-", Pts(r, h).
TV(to) :- TV(from), Assign(to, from).
TV(v) :- TH(h), Pts(v, h).
TV(to) :- TV(b), Load(to, b, _).
TV(to) :- TF(h, f), Load(to, b, f), Pts(b, h).
TF(h, f) :- TV(from), Store(b, f, from), Pts(b, h).
TS(f) :- TV(from), SStore(f, from).
TV(to) :- TS(f), SLoad(to, f).
TM(site, k) :- TV(sv), CandSrc(site, k, sv).
TV(v) :- TM(site, k), CandTgtV(site, k, v).
TH(h) :- TM(site, k), CandTgtH(site, k, h).

// ---- sinks and backward relevance ----
.decl SinkArg(site:symbol, v:Var)
SinkArg(site, a) :- LibCall(site, c, sub, _, _), SinkMethod(c, sub), Arg(site, _, a), !match("str:.*", a), !match("cls:.*", a), a != "-".
.decl BV(v:Var)
.decl BH(h:symbol)
.decl BF(h:symbol, f:symbol)
.decl BS(f:symbol)
.decl BM(site:symbol, k:number)
BV(a) :- SinkArg(_, a), TV(a).
BF(h, "[]") :- SinkArg(_, a), Pts(a, h), TF(h, "[]").
BV(from) :- BV(to), Assign(to, from), TV(from).
BH(h) :- BV(v), Pts(v, h), TH(h).
BV(b) :- BV(to), Load(to, b, _), TV(b).
BF(h, f) :- BV(to), Load(to, b, f), Pts(b, h), TF(h, f).
BV(from) :- BF(h, f), Store(b, f, from), Pts(b, h), TV(from).
BS(f) :- BV(to), SLoad(to, f), TS(f).
BV(from) :- BS(f), SStore(f, from), TV(from).
BM(site, k) :- BV(v), CandTgtV(site, k, v), TM(site, k).
BM(site, k) :- BH(h), CandTgtH(site, k, h), TM(site, k).
BV(sv) :- BM(site, k), CandSrc(site, k, sv), TV(sv).

// ---- relevant subgraph as string-named edges ----
.decl RelEdge(a:symbol, b:symbol)
RelEdge(cat("v:", from), cat("v:", to)) :- BV(to), Assign(to, from), BV(from).
RelEdge(cat("h:", h), cat("v:", v)) :- BV(v), Pts(v, h), BH(h).
RelEdge(cat("v:", b), cat("v:", to)) :- BV(to), Load(to, b, _), BV(b).
RelEdge(cat("f:", h, "|", f), cat("v:", to)) :- BV(to), Load(to, b, f), Pts(b, h), BF(h, f).
RelEdge(cat("v:", from), cat("f:", h, "|", f)) :- BF(h, f), Store(b, f, from), Pts(b, h), BV(from).
RelEdge(cat("v:", from), cat("s:", f)) :- BS(f), SStore(f, from), BV(from).
RelEdge(cat("s:", f), cat("v:", to)) :- BV(to), SLoad(to, f), BS(f).
RelEdge(cat("c:", site, "#", to_string(k)), cat("v:", v)) :- BM(site, k), CandTgtV(site, k, v), BV(v).
RelEdge(cat("c:", site, "#", to_string(k)), cat("h:", h)) :- BM(site, k), CandTgtH(site, k, h), BH(h).
.decl RelCand(mid:symbol, from:symbol, cls:symbol, sub:symbol, k:number)
RelCand(cat("c:", site, "#", to_string(k)), cat("v:", sv), c, sub, k) :-
    BM(site, k), CandSrc(site, k, sv), BV(sv), LibCall(site, c, sub, _, _).
.decl RelSrc(n:symbol)
RelSrc(cat("v:", r)) :- LibCall(_, c, sub, _, r), SourceMethod(c, sub), BV(r).
RelSrc(cat("h:", h)) :- LibCall(_, c, sub, _, r), SourceMethod(c, sub), r != "-", Pts(r, h), BH(h).
.decl RelSink(site:symbol, n:symbol)
RelSink(site, cat("v:", a)) :- SinkArg(site, a), BV(a).
RelSink(site, cat("f:", h, "|[]")) :- SinkArg(site, a), Pts(a, h), BF(h, "[]").
.output RelEdge(compress=true)
.output RelCand(compress=true)
.output RelSrc(compress=true)
.output RelSink(compress=true)

.decl Stats(what:symbol, n:number)
Stats("src_sites", n) :- n = count : { LibCall(_, c, s, _, _), SourceMethod(c, s) }.
Stats("sink_sites", n) :- n = count : { LibCall(_, c, s, _, _), SinkMethod(c, s) }.
Stats("pts", n) :- n = count : { Pts(_, _) }.
Stats("tainted_vars", n) :- n = count : { TV(_) }.
Stats("rel_vars", n) :- n = count : { BV(_) }.
Stats("rel_cands", n) :- n = count : { BM(_, _) }.
.output Stats

// ==== inter-component holes (generated by make_taint_icc.py) ====
.decl Component(c:symbol, kind:symbol, exported:symbol)
.decl IntentFilter(c:symbol, action:symbol)
.input Component, IntentFilter
.decl IccSend(sub:symbol, kind:symbol)
IccSend("void startActivity(android.content.Intent)", "activity").
IccSend("void startActivity(android.content.Intent,android.os.Bundle)", "activity").
IccSend("void startActivityForResult(android.content.Intent,int)", "activity").
IccSend("void startActivityForResult(android.content.Intent,int,android.os.Bundle)", "activity").
IccSend("void startActivities(android.content.Intent[])", "activity").
IccSend("android.content.ComponentName startService(android.content.Intent)", "service").
IccSend("android.content.ComponentName startForegroundService(android.content.Intent)", "service").
IccSend("boolean bindService(android.content.Intent,android.content.ServiceConnection,int)", "service").
IccSend("void sendBroadcast(android.content.Intent)", "receiver").
IccSend("void sendBroadcast(android.content.Intent,java.lang.String)", "receiver").
IccSend("void sendOrderedBroadcast(android.content.Intent,java.lang.String)", "receiver").
IccSend("void sendStickyBroadcast(android.content.Intent)", "receiver").
.decl IccRecvParam(sub:symbol, i:number)
IccRecvParam("void onReceive(android.content.Context,android.content.Intent)", 1).
IccRecvParam("int onStartCommand(android.content.Intent,int,int)", 0).
IccRecvParam("void onStart(android.content.Intent,int)", 0).
IccRecvParam("android.os.IBinder onBind(android.content.Intent)", 0).
IccRecvParam("void onNewIntent(android.content.Intent)", 0).
IccRecvParam("void onHandleIntent(android.content.Intent)", 0).
IccRecvParam("void onRebind(android.content.Intent)", 0).
.decl CompOrSuper(comp:symbol, cls:symbol)
CompOrSuper(c, c) :- Component(c, _, _).
CompOrSuper(c, s) :- Component(c, _, _), SubType(c, s).
.decl RecvVar(comp:symbol, v:Var)
RecvVar(c, r) :- Call(_, m, _, _, "android.content.Intent getIntent()", _, r), r != "-", MethodDecl(cls, _, m, _, _), CompOrSuper(c, cls).
RecvVar(c, v) :- IccRecvParam(sub, i), MethodDecl(cls, sub, m, _, _), CompOrSuper(c, cls), FormalParam(m, i, v).
.decl IccCand(isite:symbol, sv:Var, comp:symbol)
IccCand(cat(site, " -> ", c), sv, c) :- LibCall(site, _, sub, _, _), IccSend(sub, kind), Arg(site, 0, sv),
    !match("str:.*", sv), !match("cls:.*", sv), sv != "-", Component(c, kind, _), RecvVar(c, _).
.decl IccSite(isite:symbol, site:symbol)
IccSite(cat(site, " -> ", c), site) :- LibCall(site, _, sub, _, _), IccSend(sub, kind), Component(c, kind, _), RecvVar(c, _).
CandSrc(isite, 0, sv) :- IccCand(isite, sv, _).
CandTgtV(isite, 0, v) :- IccCand(isite, _, c), RecvVar(c, v).
RelCand(cat("c:", isite, "#0"), cat("v:", sv), "#icc", isite, 0) :- BM(isite, 0), IccCand(isite, sv, _), BV(sv).

// answer key for the candidates that ended up relevant
.decl ClsArg(site:symbol, i:number, c:symbol)
ClsArg(site, i, substr(a, 4, strlen(a) - 4)) :- Arg(site, i, a), (match("cls:.*", a) ; match("str:.*", a)).
.decl CnTarget(h:symbol, c:symbol)
CnTarget(h, c) :- Call(site, _, _, "android.content.ComponentName", sub, b, _), Pts(b, h), ClsArg(site, 1, c),
    (sub = "void <init>(android.content.Context,java.lang.Class)" ; sub = "void <init>(java.lang.String,java.lang.String)" ;
     sub = "void <init>(android.content.Context,java.lang.String)").
.decl IntentTarget(h:symbol, c:symbol)
IntentTarget(h, c) :- Call(site, _, _, "android.content.Intent", sub, b, _), Pts(b, h), ClsArg(site, 1, c),
    (sub = "void <init>(android.content.Context,java.lang.Class)" ;
     sub = "android.content.Intent setClass(android.content.Context,java.lang.Class)" ;
     sub = "android.content.Intent setClassName(android.content.Context,java.lang.String)" ;
     sub = "android.content.Intent setClassName(java.lang.String,java.lang.String)").
IntentTarget(h, c) :- Call(site, _, _, "android.content.Intent", "void <init>(java.lang.String,android.net.Uri,android.content.Context,java.lang.Class)", b, _),
    Pts(b, h), ClsArg(site, 3, c).
IntentTarget(h, c) :- Call(site, _, _, "android.content.Intent", "android.content.Intent setComponent(android.content.ComponentName)", b, _),
    Pts(b, h), Arg(site, 0, cn), Pts(cn, h2), CnTarget(h2, c).
.decl IntentAction(h:symbol, a:symbol)
IntentAction(h, substr(a, 4, strlen(a) - 4)) :- Call(site, _, _, "android.content.Intent", sub, b, _), Pts(b, h), Arg(site, 0, a), match("str:.*", a),
    (sub = "void <init>(java.lang.String)" ; sub = "void <init>(java.lang.String,android.net.Uri)" ;
     sub = "android.content.Intent setAction(java.lang.String)").
// the key reads the Intent objects created in the sending method itself when there are any (context-insensitive points-to
// merges Intents built by shared helpers); otherwise every object the sent variable may point to
.decl LocalHeap(isite:symbol, h:symbol)
LocalHeap(i, h) :- IccCand(i, sv, _), IccSite(i, site), Call(site, m, _, _, _, _, _), Pts(sv, h), contains(m, h).
.decl HasLocal(isite:symbol)
HasLocal(i) :- LocalHeap(i, _).
.decl KeyHeap(isite:symbol, h:symbol)
KeyHeap(i, h) :- LocalHeap(i, h).
KeyHeap(i, h) :- IccCand(i, sv, _), !HasLocal(i), Pts(sv, h).
.decl HasTgt(h:symbol)
HasTgt(h) :- IntentTarget(h, _).
.decl HasAct(h:symbol)
HasAct(h) :- IntentAction(h, _).
.decl HasPts(v:Var)
HasPts(v) :- Pts(v, _).
.decl IccYes(isite:symbol)
IccYes(i) :- IccCand(i, _, c), KeyHeap(i, h), IntentTarget(h, c).
IccYes(i) :- IccCand(i, _, c), KeyHeap(i, h), !HasTgt(h), IntentAction(h, a), IntentFilter(c, a).
.decl IccUnk(isite:symbol)
IccUnk(i) :- KeyHeap(i, h), !HasTgt(h), !HasAct(h).
IccUnk(i) :- IccCand(i, sv, _), !HasPts(sv).
.decl IccLabel(isite:symbol, label:symbol)
IccLabel(i, "yes") :- BM(i, 0), IccCand(i, _, _), IccYes(i).
IccLabel(i, "unk") :- BM(i, 0), IccCand(i, _, _), !IccYes(i), IccUnk(i).
IccLabel(i, "no") :- BM(i, 0), IccCand(i, _, _), !IccYes(i), !IccUnk(i).
.output IccLabel(compress=true)
// what a pricer may read about a relevant candidate: the Intent's constant targets and actions, the component's kind and filter
.decl IccInfo(isite:symbol, what:symbol, value:symbol)
IccInfo(i, "target", c2) :- BM(i, 0), KeyHeap(i, h), IntentTarget(h, c2).
IccInfo(i, "action", a) :- BM(i, 0), KeyHeap(i, h), IntentAction(h, a).
IccInfo(i, "kind", k) :- BM(i, 0), IccCand(i, _, c), Component(c, k, _).
IccInfo(i, "exported", e) :- BM(i, 0), IccCand(i, _, c), Component(c, _, e).
IccInfo(i, "filter", a) :- BM(i, 0), IccCand(i, _, c), IntentFilter(c, a).
.output IccInfo(compress=true)
Stats("icc_cands", n) :- n = count : { IccCand(_, _, _) }.
Stats("icc_rel", n) :- n = count : { IccLabel(_, _) }.
